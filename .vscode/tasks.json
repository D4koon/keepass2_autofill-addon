{
    // Build the extension and load it in Firefox.
    //
    //   Terminal > Run Task...  (or Run Build Task = Ctrl+Shift+B)
    //
    // "Kee: Build & Run in Firefox" is the default build task: it runs a full
    // production build, then launches Firefox (via web-ext) with the unpacked
    // extension from ./extension and a throw-away profile kept under
    // ./.testing-web-ext-firefox-profile.
    //
    // For iterative work use "Kee: Dev (watch + Firefox)" instead - it starts the
    // watch build (rebuilds ./extension on save) and Firefox together; web-ext
    // reloads the extension when the build output changes.
    //
    // Requires: `npm ci` already run, and a `firefox` binary on PATH.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Kee: Build (production)",
            "detail": "One-off production build (npm run build:prod). Cleans ./extension and rebuilds the web/background/page/vault bundles into it. No browser is launched.",
            "type": "npm",
            "script": "build:prod",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "Kee: Run in Firefox",
            "detail": "Launch Firefox with the current ./extension build (npm run start:firefox). Uses web-ext and the reusable profile in ./.testing-web-ext-firefox-profile; stays running and live-reloads when ./extension changes. Build first if ./extension is empty.",
            "type": "npm",
            "script": "start:firefox",
            // web-ext stays running (it owns the Firefox process); treat it as a
            // long-lived background task.
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "kee-firefox"
            }
        },
        {
            "label": "Kee: Build & Run in Firefox",
            "detail": "Default build task. Runs \"Kee: Build (production)\" to completion, then \"Kee: Run in Firefox\". Use this for a one-off try-it-in-Firefox; it does not watch for changes.",
            "dependsOrder": "sequence",
            "dependsOn": ["Kee: Build (production)", "Kee: Run in Firefox"],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Kee: Dev build (watch)",
            "detail": "Watch build for Firefox (npm run dev-firefox). Rebuilds ./extension on every save; pages are bundled to disk (no HMR - Firefox rejects the dev server's localhost CSP entry). Never exits; stop it to end the watch.",
            "type": "npm",
            "script": "dev-firefox",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "kee-firefox"
            },
            // vite --watch never exits; tell VS Code when the first build is done
            // so a dependent task may start.
            "problemMatcher": {
                "owner": "kee-dev",
                "pattern": {
                    "regexp": "^\\s*(ERROR)\\s+(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*(vite v|build started|transforming).*",
                    "endsPattern": ".*(built in|watching for file changes|page reload).*"
                }
            }
        },
        {
            "label": "Kee: Dev (watch + Firefox)",
            "detail": "Iterative workflow. Starts \"Kee: Dev build (watch)\", waits for its first build, then \"Kee: Run in Firefox\". Edit source and web-ext reloads the extension automatically; press r in the Firefox task terminal to force a full reload.",
            "dependsOrder": "sequence",
            "dependsOn": ["Kee: Dev build (watch)", "Kee: Run in Firefox"],
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
